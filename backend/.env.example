# Required: your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: a second Gemini key. If the first hits its free-tier quota
# mid-demo, the agent automatically retries with this one before falling
# back to the local template plan.
GEMINI_API_KEY_2=your_second_gemini_api_key_here

GEMINI_MODEL=gemini-3.6-flash

# Optional: if set, search_resources() will do a real web search via Tavily
# (https://tavily.com - free tier available). If left blank, the agent falls
# back to a small curated resource map so the demo still works without it.
TAVILY_API_KEY=

# Port the backend listens on
PORT=7000
